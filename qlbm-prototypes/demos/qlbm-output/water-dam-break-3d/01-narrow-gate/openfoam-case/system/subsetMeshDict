FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      subsetMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

zone
{
    type invert;
    zoneType cell;

    lowerWall
    {
        type box;
        zoneType cell;
        box (9 0 0) (11 7 2);
    }
    upperWall
    {
        type box;
        zoneType cell;
        box (9 9 0) (11 16 2);
    }
}
patch walls;
